# Hermes Agent Stack

# Credentials (NEVER commit)
credentials.txt
.env
.env.searxng

# SearXNG settings: real secret_key is generated into this file at setup time
# from the inline template in setup.ps1; never commit this file.
searxng-settings.yml

# Hermes Desktop installer downloaded to the stack dir during setup
hermes-setup.exe

# Checkpoint state (auto-generated)
.hermes-stack-state.json

# Desktop app logs (runtime state, dumped into the stack dir)
.hermes/

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# IDE
.vscode/
.idea/
*.swp
*.swo

# PowerShell module analysis cache (created in the repo dir on some runs)
Microsoft/
